{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://8lines.dev/gauntlet/release-manifest.schema.json",
  "title": "Gauntlet release manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "releaseSet", "sourceCommit", "units", "artifacts"],
  "properties": {
    "schemaVersion": {
      "const": 2
    },
    "releaseSet": {
      "type": "string",
      "pattern": "^(?:release-[0-9]{4}-[0-9]{2}-[0-9]{2}\\.[1-9][0-9]{0,2}|local-[0-9a-f]{12})$"
    },
    "sourceCommit": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "units": {
      "type": "array",
      "minItems": 1,
      "maxItems": 13,
      "items": {
        "$ref": "#/$defs/unit"
      }
    },
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "maxItems": 512,
      "items": {
        "$ref": "#/$defs/artifact"
      }
    }
  },
  "$defs": {
    "unit": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version", "tag"],
      "properties": {
        "id": {
          "enum": ["gauntlet", "protocol", "dashboard-client", "typescript-core", "typescript-node", "next-adapter", "conformance-runner", "widget", "php-core", "symfony-bundle", "java-core", "spring-boot-starter", "skills"]
        },
        "version": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$",
          "maxLength": 64
        },
        "tag": {
          "type": "string",
          "pattern": "^(?:v|[a-z]+(?:-[a-z]+)*-v)(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
        }
      }
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["unit", "kind", "name", "path", "sha256"],
      "properties": {
        "unit": {
          "enum": ["gauntlet", "protocol", "dashboard-client", "typescript-core", "typescript-node", "next-adapter", "conformance-runner", "widget", "php-core", "symfony-bundle", "java-core", "spring-boot-starter", "skills"]
        },
        "kind": {
          "enum": ["npm", "composer", "maven", "compose", "helm", "oci", "docker", "skills", "sbom", "provenance", "security"]
        },
        "name": {
          "type": "string",
          "pattern": "^[A-Za-z0-9@._+:/-]+$",
          "minLength": 1,
          "maxLength": 240
        },
        "path": {
          "type": "string",
          "pattern": "^(?!/)(?!.*\\\\)(?!.*(?:^|/)\\.\\.?(?:/|$))[A-Za-z0-9@._+:/-]+$",
          "minLength": 1,
          "maxLength": 1024
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    }
  }
}
