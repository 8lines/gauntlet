{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://8lines.dev/gauntlet/release-manifest.schema.json",
  "title": "Gauntlet release manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "version", "sourceTag", "sourceCommit", "artifacts"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "version": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$",
      "maxLength": 64
    },
    "sourceTag": {
      "type": "string",
      "pattern": "^v(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$",
      "maxLength": 65
    },
    "sourceCommit": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "maxItems": 512,
      "items": { "$ref": "#/$defs/artifact" }
    }
  },
  "$defs": {
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "name", "path", "sha256"],
      "properties": {
        "kind": {
          "enum": ["npm", "composer", "maven", "compose", "helm", "oci", "docker", "skills", "sbom", "provenance", "security"]
        },
        "name": {
          "type": "string",
          "pattern": "^[A-Za-z0-9@._+:/-]+$",
          "minLength": 1,
          "maxLength": 240
        },
        "path": {
          "type": "string",
          "pattern": "^(?!/)(?!.*\\\\)(?!.*(?:^|/)\\.\\.?(?:/|$))[A-Za-z0-9@._+:/-]+$",
          "minLength": 1,
          "maxLength": 1024
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    }
  }
}
