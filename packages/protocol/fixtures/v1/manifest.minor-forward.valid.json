{
  "protocolVersion": "1.1",
  "manifestRevision": "sha256:14c1e76d94972d7e159e2a721e36f1ab8b8d8d35daf7a7f266d3ca6530057dd7",
  "schemaDialect": "https://json-schema.org/draft/2020-12/schema",
  "profiles": [
    "gauntlet-schema-core@1",
    "gauntlet-rich-forms@1",
    "gauntlet-rich-results@1"
  ],
  "capabilities": [
    "gauntlet-uploads@1",
    "gauntlet-session-launch@1"
  ],
  "application": {
    "id": "acme-portal",
    "label": "Acme Portal",
    "environment": {
      "name": "development",
      "kind": "development"
    }
  },
  "features": [
    {
      "id": "security",
      "label": "Security",
      "order": 10
    }
  ],
  "operations": [
    {
      "id": "application-access-review",
      "revision": "sha256:ea955d5ed2fcff2e0b9274e05b0f2e9f09bd6305ffcb3169c51ef80e0b873662",
      "label": "Review application access",
      "featureId": "security",
      "availability": {
        "state": "available"
      },
      "requirements": {
        "profiles": [
          "gauntlet-schema-core@1",
          "gauntlet-rich-forms@1",
          "gauntlet-rich-results@1"
        ],
        "capabilities": [
          "gauntlet-uploads@1",
          "gauntlet-session-launch@1"
        ]
      }
    }
  ],
  "dataSources": [
    {
      "id": "application-catalog",
      "label": "Application catalog",
      "description": "Searchable applications available to the current target.",
      "capabilities": {
        "search": true,
        "pagination": "cursor",
        "resolve": true,
        "defaultLimit": 20,
        "maxLimit": 100
      },
      "dependencySchema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "required": [
          "/options/includeInactive"
        ],
        "properties": {
          "/options/includeInactive": {
            "type": "boolean"
          }
        },
        "additionalProperties": false
      },
      "contextSchema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "required": [
          "requestId",
          "target"
        ],
        "properties": {
          "requestId": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
          },
          "locale": {
            "type": "string"
          },
          "timeZone": {
            "type": "string"
          },
          "actor": {
            "type": "object",
            "required": [
              "id"
            ],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
              },
              "displayName": {
                "type": "string"
              }
            },
            "additionalProperties": false
          },
          "target": {
            "type": "object",
            "required": [
              "id"
            ],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
              },
              "environment": {
                "type": "string"
              }
            },
            "additionalProperties": false
          },
          "extensions": {
            "type": "object",
            "propertyNames": {
              "pattern": "^urn:[A-Za-z0-9][A-Za-z0-9:._/-]*$"
            }
          }
        },
        "additionalProperties": false
      }
    }
  ],
  "extensions": {
    "urn:fixture:optional": {
      "future": true
    }
  }
}
