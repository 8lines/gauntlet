{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.8lines.dev/gauntlet/v1/data-source-resolve-response.schema.json",
  "type": "object",
  "required": ["results"],
  "properties": {
    "results": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["value", "item"],
        "properties": {
          "value": { "type": "string" },
          "item": {
            "oneOf": [
              { "$ref": "./common.schema.json#/$defs/dataSourceItem" },
              { "type": "null" }
            ]
          }
        },
        "additionalProperties": false
      }
    },
    "extensions": { "$ref": "./common.schema.json#/$defs/extensions" }
  },
  "additionalProperties": false
}
