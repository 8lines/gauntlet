{
  "name": "@8lines/gauntlet-widget",
  "description": "Typed, SSR-safe commands and page-subject types for embedding the Gauntlet widget in a web application.",
  "version": "0.1.5",
  "type": "module",
  "license": "Apache-2.0",
  "engines": { "node": ">=24 <27" },
  "repository": {
    "type": "git",
    "url": "https://github.com/8lines/gauntlet.git",
    "directory": "packages/widget"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "exports": { ".": { "types": "./dist/index.d.ts", "import": "./dist/index.js" } },
  "files": ["dist", "README.md", "LICENSE"],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepack": "pnpm --filter @8lines/gauntlet-widget... build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "tsx --test test/**/*.test.ts"
  }
}
