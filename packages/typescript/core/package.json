{
  "name": "@8lines/gauntlet-typescript-core",
  "description": "Framework-neutral registries, validation, execution coordination, run management, and capability catalog for TypeScript Gauntlet adapters.",
  "version": "0.1.8",
  "type": "module",
  "license": "Apache-2.0",
  "engines": { "node": ">=24 <27" },
  "repository": {
    "type": "git",
    "url": "https://github.com/8lines/gauntlet.git",
    "directory": "packages/typescript/core"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "exports": { ".": { "types": "./dist/index.d.ts", "import": "./dist/index.js" } },
  "files": ["dist", "README.md", "LICENSE"],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepack": "pnpm --filter @8lines/gauntlet-typescript-core... build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "tsx --test test/**/*.test.ts",
    "test:package": "node scripts/test-packed-consumer.mjs"
  },
  "dependencies": {
    "@8lines/gauntlet-protocol": "workspace:*",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1"
  }
}
