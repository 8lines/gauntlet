{
  "name": "@8lines/gauntlet-typescript-node",
  "description": "Node.js Web Request and Response transport for exposing an explicitly registered Gauntlet adapter catalog.",
  "version": "0.1.0",
  "type": "module",
  "license": "Apache-2.0",
  "engines": { "node": ">=24 <27" },
  "repository": {
    "type": "git",
    "url": "https://github.com/8lines/gauntlet.git",
    "directory": "packages/typescript/node"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/",
    "provenance": true
  },
  "exports": { ".": { "types": "./dist/index.d.ts", "import": "./dist/index.js" } },
  "files": ["dist", "README.md", "LICENSE"],
  "scripts": { "build": "tsc -p tsconfig.json", "prepack": "pnpm --filter @8lines/gauntlet-typescript-node... build", "typecheck": "tsc -p tsconfig.json --noEmit", "test": "tsx --test test/**/*.test.ts" },
  "dependencies": { "@8lines/gauntlet-protocol": "workspace:*", "@8lines/gauntlet-typescript-core": "workspace:*" }
}
