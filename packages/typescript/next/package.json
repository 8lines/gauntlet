{
  "name": "@8lines/gauntlet-next-adapter",
  "description": "Next.js App Router bridge for exposing an explicitly registered Gauntlet adapter catalog through normalized Web Requests.",
  "version": "0.1.2",
  "type": "module",
  "license": "Apache-2.0",
  "engines": { "node": ">=24 <27" },
  "repository": {
    "type": "git",
    "url": "https://github.com/8lines/gauntlet.git",
    "directory": "packages/typescript/next"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "exports": { ".": { "types": "./dist/index.d.ts", "import": "./dist/index.js" } }, "files": ["dist", "README.md", "LICENSE"],
  "dependencies": { "@8lines/gauntlet-typescript-node": "workspace:*" },
  "scripts": { "build": "tsc -p tsconfig.json", "prepack": "pnpm --filter @8lines/gauntlet-next-adapter... build", "typecheck": "tsc -p tsconfig.json --noEmit", "test": "tsx --test test/**/*.test.ts" }
}
