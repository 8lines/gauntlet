{
  "name": "8lines/gauntlet-symfony-bundle",
  "description": "Symfony integration bundle for the framework-neutral Gauntlet adapter protocol.",
  "version": "0.2.0",
  "type": "symfony-bundle",
  "license": "Apache-2.0",
  "homepage": "https://github.com/8lines/gauntlet",
  "support": {
    "issues": "https://github.com/8lines/gauntlet/issues",
    "source": "https://github.com/8lines/gauntlet"
  },
  "repositories": [
    {
      "type": "path",
      "url": "../core",
      "options": {
        "symlink": false
      }
    }
  ],
  "require": {
    "php": ">=8.3",
    "8lines/gauntlet-php-core": "^0.2.0",
    "symfony/config": "^7.4 || ^8.0",
    "symfony/dependency-injection": "^7.4 || ^8.0",
    "symfony/framework-bundle": "^7.4 || ^8.0",
    "symfony/http-foundation": "^7.4 || ^8.0",
    "symfony/property-access": "^7.4 || ^8.0",
    "symfony/property-info": "^7.4 || ^8.0",
    "symfony/routing": "^7.4 || ^8.0",
    "symfony/serializer": "^7.4 || ^8.0",
    "symfony/validator": "^7.4 || ^8.0"
  },
  "require-dev": {
    "phpunit/phpunit": "^13.4",
    "symfony/browser-kit": "^7.4 || ^8.0"
  },
  "suggest": {
    "symfony/ai-mate": "Lets coding agents inspect the Gauntlet adapter wiring through vendor/bin/mate; install it as a dev dependency"
  },
  "autoload": {
    "psr-4": {
      "EightLines\\Gauntlet\\SymfonyBundle\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "EightLines\\Gauntlet\\SymfonyBundle\\Tests\\": "tests/"
    }
  },
  "config": {
    "allow-plugins": false
  },
  "extra": {
    "ai-mate": {
      "scan-dirs": ["src/Mate/Capability"],
      "includes": ["config/mate.php"],
      "instructions": "INSTRUCTIONS.md"
    }
  }
}
