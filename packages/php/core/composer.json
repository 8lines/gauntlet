{
  "name": "8lines/gauntlet-php-core",
  "description": "Framework-neutral Gauntlet adapter definitions and runtime for PHP.",
  "version": "0.1.8",
  "type": "library",
  "license": "Apache-2.0",
  "homepage": "https://github.com/8lines/gauntlet",
  "support": {
    "issues": "https://github.com/8lines/gauntlet/issues",
    "source": "https://github.com/8lines/gauntlet"
  },
  "require": {
    "php": ">=8.3",
    "ext-curl": "*",
    "ext-dom": "*",
    "ext-hash": "*",
    "ext-json": "*",
    "ext-libxml": "*",
    "ext-mbstring": "*",
    "onematrix/tracing-sdk": "1.1.0",
    "opis/json-schema": "2.6.0"
  },
  "require-dev": {
    "phpunit/phpunit": "^11.5"
  },
  "autoload": {
    "psr-4": {
      "EightLines\\Gauntlet\\Core\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "EightLines\\Gauntlet\\Core\\Tests\\": "tests/"
    }
  },
  "config": {
    "allow-plugins": false
  }
}
