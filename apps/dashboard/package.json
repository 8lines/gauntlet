{
  "name": "@8lines/gauntlet-dashboard",
  "version": "0.1.8",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:widget": "vite -c vite.widget.config.ts",
    "build": "tsc -p tsconfig.json --noEmit && vite build && vite build -c vite.widget.config.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "preview": "vite preview",
    "test": "tsx --test test/**/*.test.ts",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@8lines/gauntlet-protocol": "workspace:*",
    "@8lines/gauntlet-widget-channel": "workspace:*",
    "@fontsource-variable/geist": "5.3.0",
    "@fontsource-variable/geist-mono": "5.3.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cmdk": "1.1.1",
    "lucide-react": "1.49.0",
    "radix-ui": "1.6.7",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "tailwind-merge": "3.7.0",
    "tw-animate-css": "1.4.0"
  },
  "devDependencies": {
    "@8lines/gauntlet-widget-loader": "workspace:*",
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.55.1",
    "@tailwindcss/vite": "4.3.3",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.1.1",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2",
    "vite": "8.2.2"
  }
}
