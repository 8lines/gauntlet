{
  "name": "8lines/gauntlet-symfony-example",
  "description": "Executable Symfony reference adapter for Gauntlet protocol conformance.",
  "version": "0.1.5",
  "type": "project",
  "license": "Apache-2.0",
  "repositories": [
    {
      "type": "path",
      "url": "../../packages/php/core",
      "options": {
        "symlink": false
      }
    },
    {
      "type": "path",
      "url": "../../packages/php/symfony-bundle",
      "options": {
        "symlink": false
      }
    }
  ],
  "require": {
    "php": ">=8.3",
    "ext-pdo": "*",
    "ext-pdo_sqlite": "*",
    "8lines/gauntlet-php-core": "^0.1.5",
    "8lines/gauntlet-symfony-bundle": "^0.1.5",
    "symfony/framework-bundle": "^7.4 || ^8.0"
  },
  "require-dev": {
    "phpunit/phpunit": "^11.5",
    "symfony/browser-kit": "^7.4 || ^8.0"
  },
  "autoload": {
    "psr-4": {
      "Gauntlet\\SymfonyExample\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Gauntlet\\SymfonyExample\\Tests\\": "tests/"
    }
  },
  "config": {
    "allow-plugins": false
  }
}
